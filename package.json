{
  "name": "google-seo-mcp",
  "version": "0.14.0",
  "description": "SEO & GEO MCP server for Claude Code, Cursor, Codex and any AI agent: Google Search Console, GA4, PageSpeed & CrUX, structured data, llms.txt, AI crawler and AI citation checks, plus WordPress (Yoast, WP-CLI) and GitHub publishing, as 102 tools. Read-only mode and dry runs; self-host it or run the hosted mode with Google sign-in",
  "main": "dist/index.js",
  "scripts": {
    "test": "node --test test/unit/ && node test/smoke.mjs && node test/oauth-http.mjs && node scripts/sync-readme.mjs --check",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/auth.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "start:http": "node dist/index.js --http",
    "check:secrets": "scripts/check-secrets.sh --all",
    "prepare": "git config core.hooksPath .githooks",
    "docs:sync": "node scripts/sync-readme.mjs"
  },
  "keywords": [
    "mcp",
    "seo",
    "geo",
    "search-console",
    "google-analytics",
    "wordpress",
    "model-context-protocol",
    "mcp-server",
    "generative-engine-optimization",
    "technical-seo",
    "pagespeed-insights",
    "core-web-vitals",
    "structured-data",
    "llms-txt",
    "yoast",
    "claude",
    "ai-agents",
    "github",
    "gmail",
    "astro",
    "static-site",
    "multi-tenant",
    "google-oauth",
    "crux",
    "indexnow",
    "wayback-machine",
    "schema-org",
    "claude-code",
    "cursor",
    "codex",
    "gemini-cli",
    "aeo",
    "answer-engine-optimization",
    "ai-seo",
    "seo-tools",
    "seo-audit",
    "google-search-console",
    "ga4",
    "chatgpt",
    "perplexity",
    "ai-search"
  ],
  "type": "module",
  "bin": {
    "google-seo-mcp": "dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.2.0",
    "google-auth-library": "^11.3.4",
    "googleapis": "^188.0.0",
    "image-size": "^2.1.0",
    "sharp": "^0.35.5",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Akxan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akxan/google-seo-mcp.git"
  },
  "homepage": "https://github.com/Akxan/google-seo-mcp#readme",
  "bugs": {
    "url": "https://github.com/Akxan/google-seo-mcp/issues"
  },
  "private": true
}

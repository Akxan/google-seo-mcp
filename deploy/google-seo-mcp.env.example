# /etc/google-seo-mcp.env  (chmod 600)
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1          # keep loopback and put Nginx/Caddy in front; use 0.0.0.0 only with a token + firewall
MCP_PORT=8080
MCP_PATH=/mcp
MCP_AUTH_TOKEN=change-me-to-a-long-random-string   # openssl rand -hex 32
# One of:
GOOGLE_APPLICATION_CREDENTIALS=/etc/google-seo-mcp/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/etc/google-seo-mcp/credentials.json   # authorized_user file produced by `npm run auth`

# Nginx in front of google-seo-mcp (HTTP mode on 127.0.0.1:8080). Requirements: proxy_buffering off (SSE),
# the Authorization header passed through, a generous read timeout for long-running tools.
limit_req_zone $binary_remote_addr zone=mcp:10m rate=20r/s;   # per-IP limit: shields the bearer token from brute force
limit_req_status 429;

server {
    listen 443 ssl http2;
    server_name mcp.example.com;
    # ssl_certificate / ssl_certificate_key ... (certbot)
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /healthz { proxy_pass http://127.0.0.1:8080/healthz; }   # unauthenticated liveness: {"ok":true}

    location / {
        limit_req zone=mcp burst=40 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;          # required for SSE streaming responses
        proxy_read_timeout 600s;      # site_crawl / pagespeed stream progress notifications for minutes
        client_max_body_size 5m;
    }
}

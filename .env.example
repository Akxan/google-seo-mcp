# =====================================================================
#  google-seo-mcp — configuration and secrets (single source of truth)
#  Copy to .env (gitignored). The server loads it at startup; existing
#  environment variables take precedence. Keep private keys and JSON
#  credentials as file paths, never inline. Empty values (KEY=) count as
#  unset, also when Docker passes them through from this file.
# =====================================================================


# ---------------------------------------------------------------------
#  1. Google credentials (Search Console + GA4)
# ---------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Service-account JSON (recommended) or an authorized_user JSON from `npm run auth`.
# Add the service-account email as a user on each Search Console property
# ("Full" to submit sitemaps) and each GA4 property ("Viewer").
# GOOGLE_CREDENTIALS_JSON=    inline credentials JSON instead of a file path (container secrets)
#
# `npm run auth` (OAuth with your own Google account): pass --client-secret <file> or set
# GOOGLE_OAUTH_CLIENT_SECRET_FILE=./client_secret.json
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_PORT=53682     local callback port for the one-time browser flow
#
# GMAIL_CREDENTIALS=~/.config/google-seo-mcp/gmail.json   authorized_user JSON from `npm run auth -- --gmail` (Gmail read-only), for gmail_find_attachments / github_commit_attachment


# ---------------------------------------------------------------------
#  2. Google API keys (restrict each key to a single API)
# ---------------------------------------------------------------------
PAGESPEED_API_KEY=
# pagespeed tool — PageSpeed Insights API (free)

CRUX_API_KEY=
# crux_history tool — Chrome UX Report API (free; needs enough Chrome traffic)

GOOGLE_API_KEY=
# knowledge_graph_check tool — Knowledge Graph Search API (free)


# ---------------------------------------------------------------------
#  3. Optional third-party keys (leave empty to disable the tool)
# ---------------------------------------------------------------------
BRAVE_API_KEY=
# brand_mentions — Brave Search API (free tier)

PERPLEXITY_API_KEY=
# ai_citation_check — Perplexity Sonar API (paid per call)

GOOGLE_PLACES_API_KEY=
# reviews_snapshot — Places API (New); requires billing on the GCP project

INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=
# indexnow_submit — generate with `openssl rand -hex 16`, publish as https://<host>/<key>.txt

GITHUB_TOKEN=
# github_* tools — fine-grained PAT with Contents read/write; falls back to `gh auth token`


# ---------------------------------------------------------------------
#  4. WordPress sites (WP-CLI over SSH). Omit to disable wp_* tools.
# ---------------------------------------------------------------------
WP_SITES=[{"name":"mysite","host":"1.2.3.4","port":22,"user":"ssh_user","path":"domains/example.com/public_html","identityFile":"~/.ssh/id_ed25519"}]
# Requires WP-CLI on the host and passwordless SSH from this machine.
# Helper scripts are uploaded to ~/.google-seo-mcp/ on the host on first use.


# ---------------------------------------------------------------------
#  5. Server options (all optional; stdio mode needs none of them)
# ---------------------------------------------------------------------
# MCP_TRANSPORT=http          enable Streamable HTTP for a 24/7 server
# MCP_HOST=127.0.0.1
# MCP_PORT=8080
# MCP_PATH=/mcp
# MCP_AUTH_TOKEN=             `openssl rand -hex 32`; required when exposing HTTP
# SEO_MCP_READ_ONLY=1         register no write tools
# SEO_MCP_TOOLSETS=gsc,ga4,web,geo,analysis,wordpress,github,gmail
# SEO_MCP_MAX_RESULT_CHARS=120000   cap on one tool result; the longest arrays are trimmed beyond it


# ---------------------------------------------------------------------
#  6. Hosted mode (optional): a web UI where other people sign in with
#     Google and get their own read-only token for /mcp. All four are
#     required together; leave them empty for a private single-user server.
# ---------------------------------------------------------------------
# SEO_MCP_HOSTED_CLIENT_ID=      OAuth client of type "Web application" (GCP → APIs & Services → Credentials);
# SEO_MCP_HOSTED_CLIENT_SECRET=  authorised redirect URI must be <SEO_MCP_PUBLIC_URL>/oauth/callback
# SEO_MCP_HOSTED_SECRET=         `openssl rand -hex 32`; encrypts stored refresh tokens and signs cookies (changing it logs everyone out)
# SEO_MCP_PUBLIC_URL=https://mcp.example.com   public origin, no trailing slash
# SEO_MCP_DATA_DIR=              where hosted.db lives (default ~/.config/google-seo-mcp; the container uses /data)
# SEO_MCP_HOSTED_CONTACT=        contact shown on the privacy page (default: the GitHub issues URL)
# SEO_MCP_HOSTED_VERIFIED=1      hide the "unverified app" notice once Google has verified the OAuth consent screen
